# ─────────────────────────────────────────────────
# MongoDB — Get free DB at https://cloud.mongodb.com
# ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/talentlens?retryWrites=true&w=majority

# ─────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────────
# JWT — Use any long random string as secret
# ─────────────────────────────────────────────────
JWT_SECRET=talentlens_super_secret_key_change_this_in_production_xyz789abc123
JWT_EXPIRE=7d

# ─────────────────────────────────────────────────
# OpenRouter AI — Get free key at https://openrouter.ai/keys
# ─────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
AI_MODEL=meta-llama/llama-3-8b-instruct:free
# ─────────────────────────────────────────────────
# Frontend URL (for CORS)
# Dev: http://localhost:5173
# Production: https://your-frontend.onrender.com
# ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
